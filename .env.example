# GeoFix web — environment configuration
# Point to your Express + MongoDB Atlas backend server (default: http://localhost:4000)

VITE_API_BASE_URL=http://localhost:4000

# Optional: real Google Maps renderer for the admin live map / worker maps.
# Leave empty to use the built-in offline stylized map.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: run without the backend using seeded localStorage demo data.
# Uncomment to enable demo mode (one-tap demo accounts on the login page):
# VITE_DATA_MODE=demo