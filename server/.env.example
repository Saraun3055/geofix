# GeoFix backend — environment
# Copy to `.env` and set your MongoDB Atlas connection string (or local MongoDB).

# MongoDB Atlas connection string (replace credentials & cluster name)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.nvaxgpy.mongodb.net/geofix?appName=Cluster0
# Or for local dev: MONGO_URI=mongodb://127.0.0.1:27017/geofix

# Secret for signing JWTs. Change in real deployments.
JWT_SECRET=dev_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Access token lifetime (e.g. 1h)
JWT_ACCESS_TTL=1h
# Refresh token lifetime (e.g. 30d)
JWT_REFRESH_TTL=30d

# Express port
PORT=4000

# Vite dev origin the API should accept + allow cookies
CORS_ORIGIN=http://localhost:5173